            <outputDirectory>.</outputDirectory>
            <source>${project.basedir}/target/resources/wsdl/MedicineCard_old-inline_2022_01_01.wsdl</source>
            <destName>MedicineCard-inline_2022_01_01.wsdl</destName>
        </file>

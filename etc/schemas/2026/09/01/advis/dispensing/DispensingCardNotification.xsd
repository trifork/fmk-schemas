<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:mc160="http://fmk-teknik.dk/160/advis"
        targetNamespace="http://fmk-teknik.dk/160/advis"
		elementFormDefault="qualified">

	<include schemaLocation="DispensingCardNotificationAction.xsd"/>
	<include schemaLocation="DispensingCardIdentifiers.xsd"/>

	<element name="DispensingCardNotification" type="mc160:DispensingCardNotificationType"/>

	<complexType name="DispensingCardNotificationType">
		<annotation>
			<documentation xml:lang="en-GB">Notification that an event has occurred on a person's dispensing card</documentation>
			<documentation xml:lang="da-DK">Notifikation om, at en hændelse er indtruffet på en persons dispenseringskort</documentation>
		</annotation>
		<sequence>
			<element name="Action" type="mc160:DispensingCardNotificationActionType"/>
			<element name="DispensingCard" type="mc160:DispensingCardIdentifiersType"/>
            <any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
		</sequence>
	</complexType>
</schema>

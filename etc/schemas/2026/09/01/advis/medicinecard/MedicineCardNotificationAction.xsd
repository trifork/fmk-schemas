<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
		xmlns:mc160="http://fmk-teknik.dk/160/advis"
		targetNamespace="http://fmk-teknik.dk/160/advis"
		elementFormDefault="qualified">

	<include schemaLocation="../common/UndefinedModificationAction.xsd"/>
	<include schemaLocation="../common/TrackAndTraceModificationAction.xsd"/>
	<include schemaLocation="DrugAdministrationModificationAction.xsd"/>
	<include schemaLocation="DrugMedicationModificationAction.xsd"/>
	<include schemaLocation="HandoverModificationAction.xsd"/>
	<include schemaLocation="LoosePrescriptionModificationAction.xsd"/>
	<include schemaLocation="OrderModificationAction.xsd"/>
	<include schemaLocation="RequestForWarrantModificationAction.xsd"/>
	<include schemaLocation="WarrantModificationAction.xsd"/>

	<simpleType name="MedicineCardNotificationActionType">
		<annotation>
			<documentation xml:lang="en-GB">Any action that can be notified on a medicine card, naming the entity it concerns</documentation>
			<documentation xml:lang="da-DK">Enhver handling, der kan notificeres på et medicinkort, med angivelse af den enhed, den vedrører</documentation>
		</annotation>
		<union memberTypes="mc160:PredefinedMedicineCardModificationActionType
							mc160:PredefinedDrugMedicationModificationActionType
							mc160:PredefinedDrugAdministrationModificationActionType
							mc160:PredefinedWarrantModificationActionType
							mc160:PredefinedHandoverModificationActionType
							mc160:PredefinedLoosePrescriptionModificationActionType
							mc160:PredefinedOrderModificationActionType
							mc160:PredefinedRequestForWarrantModificationActionType
							mc160:PredefinedTrackAndTraceModificationActionType
							mc160:UndefinedModificationActionType"/>
	</simpleType>

	<simpleType name="PredefinedMedicineCardModificationActionType">
		<annotation>
			<documentation xml:lang="en-GB">Type of modification of the medicine card itself</documentation>
			<documentation xml:lang="da-DK">Type af ændring af selve medicinkortet</documentation>
		</annotation>
		<restriction base="mc160:UndefinedModificationActionType">
			<enumeration value="MedicineCardReviewed"/>
			<enumeration value="MedicineCardNotReviewed"/>
			<enumeration value="MedicineCardInvalidated"/>
			<enumeration value="MedicineCardInvalidCleared"/>
		</restriction>
	</simpleType>
</schema>

<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
		xmlns:mc160="http://fmk-teknik.dk/160/advis"
		targetNamespace="http://fmk-teknik.dk/160/advis"
		elementFormDefault="qualified">

	<include schemaLocation="../common/UndefinedAction.xsd"/>
	<include schemaLocation="../common/TrackAndTraceAction.xsd"/>
	<include schemaLocation="DrugAdministrationAction.xsd"/>
	<include schemaLocation="DrugMedicationAction.xsd"/>
	<include schemaLocation="HandoverAction.xsd"/>
	<include schemaLocation="LoosePrescriptionAction.xsd"/>
	<include schemaLocation="OrderAction.xsd"/>
	<include schemaLocation="RequestForWarrantAction.xsd"/>
	<include schemaLocation="WarrantAction.xsd"/>

	<simpleType name="MedicineCardActionType">
		<annotation>
			<documentation xml:lang="en-GB">Any action that can be notified on a medicine card, naming the entity it concerns</documentation>
			<documentation xml:lang="da-DK">Enhver handling, der kan notificeres på et medicinkort, med angivelse af den enhed, den vedrører</documentation>
		</annotation>
		<union memberTypes="mc160:PredefinedMedicineCardActionType
							mc160:PredefinedDrugMedicationActionType
							mc160:PredefinedDrugAdministrationActionType
							mc160:PredefinedWarrantActionType
							mc160:PredefinedHandoverActionType
							mc160:PredefinedLoosePrescriptionActionType
							mc160:PredefinedOrderActionType
							mc160:PredefinedRequestForWarrantActionType
							mc160:PredefinedTrackAndTraceActionType
							mc160:UndefinedActionType"/>
	</simpleType>

	<simpleType name="PredefinedMedicineCardActionType">
		<annotation>
			<documentation xml:lang="en-GB">Type of action for the medicine card itself</documentation>
			<documentation xml:lang="da-DK">Type af handling for selve medicinkortet</documentation>
		</annotation>
		<restriction base="mc160:UndefinedActionType">
			<enumeration value="MedicineCardReviewed"/>
			<enumeration value="MedicineCardNotReviewed"/>
			<enumeration value="MedicineCardInvalidated"/>
			<enumeration value="MedicineCardInvalidCleared"/>
		</restriction>
	</simpleType>
</schema>

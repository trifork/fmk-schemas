<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns:mc160="http://fmk-teknik.dk/160"
        xmlns="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://fmk-teknik.dk/160"
        elementFormDefault="qualified" attributeFormDefault="unqualified">

    <include schemaLocation="Dosage.xsd"/>

    <complexType name="WeekType">
        <annotation>
            <documentation xml:lang="en-GB">Represents a single week in a weekday-based dosage. Contains up to 7 weekday entries, each specifying the weekday and its dosage. A week can be empty.</documentation>
            <documentation xml:lang="da-DK">Repræsenterer en enkelt uge i en ugedagsbaseret dosering. Indeholder op til 7 ugedage, hver med angivelse af ugedag og tilhørende dosering. En uge kan være tom.</documentation>
        </annotation>
        <sequence>
            <element name="Index" type="mc160:WeekIndexType"/>
            <element name="Weekday" type="mc160:Weekday" maxOccurs="7"/>
        </sequence>
    </complexType>

    <simpleType name="WeekIndexType">
        <annotation>
            <documentation xml:lang="en-GB">The index of a week within a dosage cycle, from 1 to 53</documentation>
            <documentation xml:lang="da-DK">Indekset for en uge i en doseringscyklus, fra 1 til 53</documentation>
        </annotation>
        <restriction base="int">
            <minInclusive value="1"/>
            <maxInclusive value="53"/>
        </restriction>
    </simpleType>

    <complexType name="Weekday">
        <annotation>
            <documentation xml:lang="en-GB">A specific weekday and the dosage to be administered on that day.</documentation>
            <documentation xml:lang="da-DK">En specifik ugedag med den dosering der skal administreres på den pågældende dag.</documentation>
        </annotation>
        <sequence>
            <element name="Label" type="mc160:WeekdayLabelType"/>
            <element name="Dosage" type="mc160:DosageChoiceType"/>
        </sequence>
    </complexType>

    <simpleType name="WeekdayLabelType">
        <annotation>
            <documentation xml:lang="en-GB">The name of a weekday (Monday through Sunday).</documentation>
            <documentation xml:lang="da-DK">Navnet på en ugedag (Monday til Sunday).</documentation>
        </annotation>
        <restriction base="string">
            <enumeration value="Monday"/>
            <enumeration value="Tuesday"/>
            <enumeration value="Wednesday"/>
            <enumeration value="Thursday"/>
            <enumeration value="Friday"/>
            <enumeration value="Saturday"/>
            <enumeration value="Sunday"/>
        </restriction>
    </simpleType>
</schema>
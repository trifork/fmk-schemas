<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
		xmlns:mc160="http://fmk-teknik.dk/160"
		targetNamespace="http://fmk-teknik.dk/160"
		elementFormDefault="qualified" attributeFormDefault="unqualified">

	<include schemaLocation="VersionMismatchWarning.xsd"/>
	<include schemaLocation="HiddenData.xsd"/>
	<include schemaLocation="PagingResponse.xsd"/>
	<include schemaLocation="FMKDetail.xsd"/>
	<include schemaLocation="MinLogSessionIdType.xsd"/>
	<include schemaLocation="MedicineCardIsInvalid.xsd"/>
	<include schemaLocation="KnownPersonIdentifiers.xsd"/>
	<include schemaLocation="ResponseInformation.xsd"/>
    <include schemaLocation="FMKConfigurationLastUpdatedType.xsd"/>
	<include schemaLocation="FMKResponseHeaderBody.xsd"/>
	<!--
		DO NOT REMOVE, even though this wrapper does not use the element.

		fmk-160-schema-classes generates from the _old contract, because that is the only closure
		containing FMKRequestHeader.xsd and the server needs FMKRequestHeaderType to parse old-shape
		requests. The free-standing FMKConfigurationUpdatedWarning element is otherwise reachable
		only from the canonical contract, so without this include the generated jar cannot marshal
		it and the server cannot answer a new-shape client.

		In other words: the _old closure has to be a superset, because it is the code-generation
		source for a server that speaks both shapes. Same reason PreflightOnly, MinLogSessionId and
		the other free-standing globals are declared here but unused by this wrapper.
	-->
	<include schemaLocation="FMKConfigurationUpdatedWarning.xsd"/>

	<element name="FMKResponseHeader" type="mc160:FMKResponseHeaderType">
		<annotation>
			<documentation xml:lang="en-GB">Generic response header to be used for common response values</documentation>
			<documentation xml:lang="da-DK">Fælles response header indeholdende fælles værdier på tværs af svar</documentation>
		</annotation>
	</element>
	<complexType name="FMKResponseHeaderType">
		<sequence>
			<element name="KnownPersonIdentifiers" type="mc160:KnownPersonIdentifiersType" minOccurs="0"/>
			<element name="MedicinecardInvalid" type="mc160:MedicineCardIsInvalidType" minOccurs="0"/>
			<element name="VersionMismatchWarning" type="mc160:VersionMismatchWarningType" minOccurs="0"/>
			<element name="HiddenData" type="mc160:HiddenDataType" minOccurs="0"/>
			<element name="Paging" type="mc160:PagingResponseType" minOccurs="0"/>
			<element name="Warnings" type="mc160:WarningsType" minOccurs="0" />
			<element name="FMKConfigurationUpdatedWarning" type="mc160:FMKConfigurationLastUpdatedType" minOccurs="0"/>
			<element name="Informations" type="mc160:ResponseInformationsType" minOccurs="0"/>
		</sequence>
	</complexType>
</schema>

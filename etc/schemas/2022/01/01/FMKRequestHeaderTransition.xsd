<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
		xmlns:mc160="http://fmk-teknik.dk/160"
		targetNamespace="http://fmk-teknik.dk/160"
		elementFormDefault="qualified" attributeFormDefault="unqualified">

	<!--
		TRANSITION-ONLY wrapper. Not for publication to clients.

		Identical to FMKRequestHeader.xsd except that WhitelistingHeader is optional.
		During the transition a client may send whitelisting EITHER inside this wrapper
		(old style) OR as a free-standing SOAP header (new style), so neither position
		can be schema-mandatory. Presence of exactly one of the two is enforced in the
		FMK server instead.

		In 2022_01_01 and 2022_01_01_E1 whitelisting stays mandatory: the original keeps
		minOccurs defaulting to 1 inside FMKRequestHeaderType, and _E1 asserts
		wsdl:required='true' on the free-standing header.

		This file declares the SAME global element name as FMKRequestHeader.xsd and must
		therefore never be included alongside it - the _Transition WSDL includes this one
		INSTEAD. That is why the sub-schema includes below are repeated here rather than
		delegated.
	-->

	<include schemaLocation="OnBehalfOf.xsd"/>
	<include schemaLocation="ConsentHeader.xsd"/>
	<include schemaLocation="WhitelistingHeader.xsd"/>
	<include schemaLocation="PagingRequest.xsd"/>
	<include schemaLocation="MinLogSessionIdType.xsd"/>
	<include schemaLocation="PreflightFlag.xsd"/>
	<include schemaLocation="PartOfBatchOperationFlag.xsd"/>
	<include schemaLocation="ExtendedValidationRequestHeader.xsd"/>
	<include schemaLocation="FMKConfigurationLastUpdatedType.xsd"/>

	<element name="FMKRequestHeader" type="mc160:FMKRequestHeaderTransitionType">
		<annotation>
			<documentation xml:lang="en-GB">Generic request header to be used for common request parameters. Transition variant: every element is optional, because whitelisting may instead arrive as a free-standing SOAP header.</documentation>
			<documentation xml:lang="da-DK">Fælles request header indeholdende fælles parametre på tværs af requests. Transitions-variant: alle elementer er optionelle, da whitelisting i stedet kan sendes som en fritstående SOAP header.</documentation>
		</annotation>
	</element>
	<complexType name="FMKRequestHeaderTransitionType">
		<sequence>
			<element name="OnBehalfOfHeader" type="mc160:OnBehalfOfType" minOccurs="0"/>
			<element name="WhitelistingHeader" type="mc160:WhitelistingHeaderType" minOccurs="0"/>
			<element name="ConsentHeader" type="mc160:ConsentHeaderType" minOccurs="0"/>
			<element name="MinLogSessionId" type="mc160:MinLogSessionIdType" minOccurs="0"/>
			<element name="Paging" type="mc160:PagingRequestType" minOccurs="0"/>
			<element name="ExtendedValidationHeader" type="mc160:ExtendedValidationRequestHeaderType" minOccurs="0"/>
			<element name="FMKConfigurationLastUpdated" type="mc160:FMKConfigurationLastUpdatedType" minOccurs="0"/>
			<element name="PreflightOnly" type="mc160:PreflightFlagType" minOccurs="0"/>
			<element name="PartOfBatchOperation" type="mc160:PartOfBatchOperationFlagType" minOccurs="0"/>
		</sequence>
	</complexType>
</schema>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dk.medicinkortet</groupId>
        <artifactId>medicinkortet-schema</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>dk.medicinkortet</groupId>
    <artifactId>MedicineCard_2022_01_01</artifactId>
    <version>${revision}</version>

    <!--
        The 2022_01_01 contract (DGWS). Header elements travel as free-standing SOAP
        headers; Paging and ExtendedValidationHeader sit in the request body, and most of
        FMKResponseHeader in the response body.

        This shape replaced the wrapper-header shape, which is frozen in mc160old_wsdl and
        published as MedicineCard_old_2022_01_01 for the duration of the migration. Both
        artifacts publish the same WSDL filename, so a client moves between them by
        changing one Maven coordinate.
    -->
    <dependencies>
        <dependency>
            <groupId>dk.medicinkortet</groupId>
            <artifactId>SchemaLoader</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>schemaload-dgws-medicinecard</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-DVersionDate=2022_01_01</argument>
                                <argument>-DWsdlName=MedicineCard</argument>
                                <argument>-Dtarget.dir=target/resources</argument>
                                <argument>-Xmx1024m</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>dk.medicinkortet.xmlschema.SchemaLoader</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>schemaload-dgws-patientregistration</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-DVersionDate=2022_01_01</argument>
                                <argument>-DWsdlName=PatientRegistration</argument>
                                <argument>-Dtarget.dir=target/resources</argument>
                                <argument>-Xmx1024m</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>dk.medicinkortet.xmlschema.SchemaLoader</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-assembly-mc</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                            <finalName>_</finalName>
                            <descriptors>
                                <descriptor>${project.parent.basedir}/src/assembly/mc160.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                    <execution>
                        <id>make-assembly-mc-inline</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                            <finalName>_</finalName>
                            <descriptors>
                                <descriptor>${project.parent.basedir}/src/assembly/mc160-inline.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                    <execution>
                        <id>make-assembly-por</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                            <finalName>_</finalName>
                            <descriptors>
                                <descriptor>${project.parent.basedir}/src/assembly/por160.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                    <execution>
                        <id>make-assembly-por-inline</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                            <finalName>_</finalName>
                            <descriptors>
                                <descriptor>${project.parent.basedir}/src/assembly/por160-inline.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
